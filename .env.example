# Stockwell server-side only. Never use NEXT_PUBLIC_ prefixes for these.
# Drivebase instance + API key + project (get the key from Drivebase: API keys page)
DRIVEBASE_API_BASE_URL=https://drivebaseaz.vercel.app/api/v1
DRIVEBASE_API_KEY=
# Optional but recommended in production: unlocks the app with a password.
# Generate with: openssl rand -base64 24
STOCKWELL_ACCESS_TOKEN=
